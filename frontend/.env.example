# Spring Boot backend (REST + /ws-tracker SockJS endpoint) as seen from the browser
NEXT_PUBLIC_API_URL=http://localhost:8080
# Backend address as seen from the Next.js server (only differs inside Docker: http://backend:8080)
INTERNAL_API_URL=http://localhost:8080
# Optional: Stripe publishable key (international cards)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Optional: hosted map tiles (default: OpenStreetMap)
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=
# Optional: contact details shown in the top bar, footer and sign-in page
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_EMAIL=
