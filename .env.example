# =====================================================================
# QuickCart configuration — copy to .env (same folder as docker-compose.yml).
# Every integration is optional: the app boots with none of them and the
# checkout lists only what is configured. NEVER commit .env.
# =====================================================================

# ---------- Social login (https://console.cloud.google.com / github.com/settings/developers)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------- Razorpay (https://dashboard.razorpay.com → Account & Settings → API Keys; use Test Mode keys first)
# Enables UPI (Google Pay / PhonePe / Paytm intents & QR), cards, netbanking and wallets.
# Webhook URL: https://<your-backend>/api/v1/payments/razorpay/webhook
#   events: payment.authorized, payment.captured, payment.failed, order.paid, refund.processed, refund.failed
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- PhonePe PG (https://business.phonepe.com → Developer settings). SANDBOX or PRODUCTION
# Webhook URL: https://<your-backend>/api/v1/payments/phonepe/webhook (set username/password there too)
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_ENV=SANDBOX
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# ---------- Direct UPI (Google Pay & any UPI app via intent/QR, without a gateway)
# Your merchant VPA. With UPI_SANDBOX_AUTO_CONFIRM=true payments auto-confirm (demo);
# set false in production so the store verifies each UTR in the control tower.
UPI_VPA=
UPI_PAYEE_NAME=QuickCart
UPI_SANDBOX_AUTO_CONFIRM=true

# ---------- Stripe (international cards, optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ---------- Product images: object storage + CDN
# auto = Supabase if its service key is set, else S3 if configured, else local disk
STORAGE_PROVIDER=auto
SUPABASE_URL=
# Supabase dashboard → Project Settings → API keys → service_role / secret key (server-side only!)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images
# S3-compatible alternative (AWS S3 + CloudFront, Cloudflare R2, MinIO)
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=
# Optional CDN in front of the bucket, e.g. https://dxxxx.cloudfront.net
IMAGE_CDN_BASE_URL=

# ---------- Address autocomplete & geocoding (blank = free OpenStreetMap: Photon + Nominatim)
# Enable "Places API (New)" and "Geocoding API" for this key.
GOOGLE_MAPS_API_KEY=
# Contact address sent to the free OSM services (required by their usage policy)
GEO_CONTACT_EMAIL=

# ---------- Storefront contact details (top bar, footer, sign-in page)
SUPPORT_PHONE=
SUPPORT_EMAIL=

# ---------- Ops alerts: Slack incoming webhook (https://api.slack.com/messaging/webhooks)
SLACK_WEBHOOK_URL=

# ---------- Database (blank = local Postgres container). Supabase: Connect → Session pooler (JDBC)
# DB_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
# DB_USERNAME=postgres.<project-ref>
# DB_PASSWORD=<database password>

# ---------- Production
# FRONTEND_URL=https://shop.example.com
# CORS_ORIGINS=https://shop.example.com
# PUBLIC_API_URL=https://api.example.com
# COOKIE_SECURE=true
# JWT_SECRET=<base64 256-bit secret>
